# Skopiuj do .env (nie commituj .env)
# Używane TYLKO przez narzędzia developerskie (daily-report / send-report / quality-loop).
# Nie jest wbudowane w bundle produkcyjny.
# NIGDY nie wpisuj tu prawdziwych haseł do repozytorium.

# Odbiorca Daily Developer Mail — wyłącznie właściciel projektu
DEVELOPER_REPORT_EMAIL=krispolik6@gmail.com

# Ustaw 1 aby włączyć faktyczną wysyłkę SMTP (npm run send-report / daily-mail / quality-loop)
DEVELOPER_MAIL_SEND=

# SMTP — wypełnij lokalnie w .env
# Przykład Gmail (hasło aplikacji) lub SMTP hostingu domeny regionalergeschmack.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Regionaler Smak <raporty@regionalergeschmack.com>

# Instrukcja: docs/daily/DEVELOPER-MAIL.md
